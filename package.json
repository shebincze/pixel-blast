{
  "name": "pixel-blast",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel Blast - pixelova skakacka (web + Android)",
  "scripts": {
    "serve": "python3 -m http.server 5173",
    "build": "node scripts/stamp.mjs && node scripts/build.mjs",
    "sync": "npm run build && npx cap sync android",
    "android": "npm run sync && npx cap open android",
    "stamp": "node scripts/stamp.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  }
}
